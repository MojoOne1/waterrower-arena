# Nach .env kopieren (neben docker-compose.yml) und ausfüllen.

# Pflicht: das erste Login. Wird nur gelesen, solange es noch keinen
# Athleten "admin" gibt.
ARENA_ADMIN_PASSWORD=

# Pflicht, solange der cloudflared-Dienst in docker-compose.yml steht:
# Cloudflare Zero Trust -> Networks -> Tunnels.
TUNNEL_TOKEN=

# 1 hinter dem Tunnel (HTTPS). Nur beim Testen über http://<host>:8090 auf 0
# setzen: über http wird ein Secure-Cookie verworfen, und das Anmelden
# "klebt" nicht. Nur der Wert 0 schaltet es aus; die Zeile zu löschen
# lässt es an.
ARENA_SECURE_COOKIES=1

# Auf 1 setzen (zusammen mit einem neuen ARENA_ADMIN_PASSWORD), um ein
# vergessenes Admin-Passwort beim nächsten Start zurückzusetzen. Danach
# wieder auf 0.
ARENA_ADMIN_RESET=0
